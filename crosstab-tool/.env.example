# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
#
# Prefix must match whatever `connection:` name your job config uses
# (e.g. `connection: REDSHIFT_MAIN` in configs/*.yaml).

REDSHIFT_MAIN_HOST=your-cluster.redshift.amazonaws.com
REDSHIFT_MAIN_DB=your_database
REDSHIFT_MAIN_USER=your_username
REDSHIFT_MAIN_PW=your_password
REDSHIFT_MAIN_PORT=5439

GOOGLE_APPLICATION_CREDENTIALS=your_credentials